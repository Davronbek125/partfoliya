# AI yordamchi (ixtiyoriy).
# Kalit bo'lmasa sayt o'rnatilgan fallback javoblardan foydalanadi.
#
# OpenRouter (tavsiya etiladi) — bitta kalit bilan ko'p modellarga kirish:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# To'g'ridan-to'g'ri OpenAI bilan ishlash uchun yuqoridagi ikkitasini
# quyidagilarga almashtiring:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Eslatma: kalitni hech qachon repoga commit qilmang. Vercel'da
# Project → Settings → Environment Variables bo'limiga qo'shing.
